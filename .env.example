# ההגדרות של הבוט. במסלול Claude Code ממלאים אותן כאן, ואותן מעתיקים גם ל-Vercel.
# הקובץ .env.local לא עולה ל-GitHub, וזה בכוונה.

# הטוקן מ-BotFather
TELEGRAM_TOKEN=
# מפתח ה-AI: Gemini (AIza...), Claude (sk-ant-...) או ChatGPT (sk-...)
AI_API_KEY=
# סיסמה לעמוד ההקמה, לפחות 8 תווים
SETUP_PASSWORD=
# הכתובת של הבוט אחרי הפריסה, למשל https://telegram-assistant-xxxx.vercel.app
KIT_URL=

# תוספת "הודעות קוליות" (לא חובה)
GROQ_API_KEY=

# תוספת "יומן Google ו-Gmail" (לא חובה)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
